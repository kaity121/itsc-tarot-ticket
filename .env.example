AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here

# Persistent Storage for Reading Tickets (Optional for Vercel production)
# If omitted, local disk storage (data/readings/) is used in development.
# On Vercel, connect Vercel KV or Upstash Redis to persist tickets across devices:
# KV_REST_API_URL=https://...upstash.io
# KV_REST_API_TOKEN=...
# or
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...